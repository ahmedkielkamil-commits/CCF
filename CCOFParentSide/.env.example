# Backend API base URL (REST + WebSocket).
# Local: http://localhost:8080
# Cloud Run: https://your-backend-service.run.app (no trailing slash)
VITE_API_URL=http://localhost:8080

# Landing page hours display (optional)
VITE_CLINIC_HOURS=8:00 AM - 5:00 PM

# Show cross-links to other local frontends in the UI
VITE_SHOW_DEV_LINKS=false
