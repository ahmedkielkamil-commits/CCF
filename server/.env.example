PORT=8080
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ccof_walkin

# Local: redis://127.0.0.1:6379
# Redis Cloud (TLS): rediss://USERNAME:PASSWORD@HOST:PORT
REDIS_URL=redis://127.0.0.1:6379

AVG_VISIT_MINUTES=15
CLINIC_HOURS=8:00 AM - 5:00 PM

# Comma-separated Firebase Hosting origins (parent + staff apps)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# HIPAA: Staff-only route IP allowlist (PATCH /queue, PUT/DELETE /clinic/wait-interval, PUT/DELETE /clinic/hours, GET /sync)
# Comma-separated IPs or CIDR ranges, e.g. 192.168.1.0/24,10.0.0.5
# Leave empty in development to allow all (a warning will be logged once).
# REQUIRED in production — set to your clinic network CIDR.
STAFF_ALLOWED_IPS=

# Twilio (test SMS via /hello.html)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555555555

# HIPAA: Production requires HTTPS. Cloud Run / load balancer must terminate TLS and forward
# X-Forwarded-Proto: https. enforceHttps middleware returns 403 for plain HTTP in production.
# No action needed locally — http://localhost is always allowed.
